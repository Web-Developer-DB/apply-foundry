{
  "schemaVersion": 2,
  "kind": "apply-foundry-dependencies",
  "minimumPythonVersion": "3.11",
  "supportedArchitectures": ["x86_64"],
  "managerPrecedence": [
    "apt",
    "dnf",
    "yum",
    "pacman",
    "zypper"
  ],
  "packageManagers": {
    "apt": {
      "executable": "apt-get",
      "components": {
        "coreRuntime": {
          "packages": ["python3"],
          "source": "APT-Distribution"
        },
        "browser": {
          "packages": ["chromium"],
          "source": "APT-Distribution"
        },
        "fonts": {
          "packages": ["fonts-liberation2"],
          "source": "APT-Distribution"
        },
        "shellcheck": {
          "packages": ["shellcheck"],
          "source": "APT-Distribution"
        }
      }
    },
    "dnf": {
      "executable": "dnf",
      "components": {
        "coreRuntime": {
          "packages": ["python3"],
          "source": "DNF-Distribution"
        },
        "browser": {
          "packages": ["chromium"],
          "source": "DNF-Distribution"
        },
        "fonts": {
          "packages": ["liberation-sans-fonts"],
          "source": "DNF-Distribution"
        },
        "shellcheck": {
          "packages": ["ShellCheck"],
          "source": "DNF-Distribution"
        }
      }
    },
    "yum": {
      "executable": "yum",
      "components": {
        "coreRuntime": {
          "packages": ["python3"],
          "source": "YUM-Distribution"
        },
        "browser": {
          "packages": ["chromium"],
          "source": "YUM-Distribution"
        },
        "fonts": {
          "packages": ["liberation-sans-fonts"],
          "source": "YUM-Distribution"
        },
        "shellcheck": {
          "packages": ["ShellCheck"],
          "source": "YUM-Distribution"
        }
      }
    },
    "pacman": {
      "executable": "pacman",
      "components": {
        "coreRuntime": {
          "packages": ["python"],
          "source": "Pacman-Distribution"
        },
        "browser": {
          "packages": ["chromium"],
          "source": "Pacman-Distribution"
        },
        "fonts": {
          "packages": ["ttf-liberation"],
          "source": "Pacman-Distribution"
        },
        "shellcheck": {
          "packages": ["shellcheck"],
          "source": "Pacman-Distribution"
        }
      }
    },
    "zypper": {
      "executable": "zypper",
      "components": {
        "coreRuntime": {
          "packages": ["python3"],
          "source": "Zypper-Distribution"
        },
        "browser": {
          "packages": ["chromium"],
          "source": "Zypper-Distribution"
        },
        "fonts": {
          "packages": ["liberation-fonts"],
          "source": "Zypper-Distribution"
        },
        "shellcheck": {
          "packages": ["ShellCheck"],
          "source": "Zypper-Distribution"
        }
      }
    }
  },
  "platforms": {
    "windows": {
      "packageManager": "winget",
      "components": {
        "coreRuntime": {"packages": ["Python.Python.3.13"], "source": "winget"},
        "browser": {"packages": ["Google.Chrome"], "source": "winget"},
        "fonts": {"packages": [], "source": "Windows-Systemschrift Arial"},
        "shellcheck": {"packages": ["koalaman.shellcheck"], "source": "winget"}
      }
    },
    "macos": {
      "packageManager": "brew",
      "components": {
        "coreRuntime": {"packages": ["python@3.13"], "source": "Homebrew formula"},
        "browser": {"packages": ["google-chrome"], "source": "Homebrew cask"},
        "fonts": {"packages": ["font-liberation"], "source": "Homebrew cask"},
        "shellcheck": {"packages": ["shellcheck"], "source": "Homebrew formula"}
      }
    }
  }
}
